[Proxy]




[Remote Proxy]
花云 = 订阅地址,udp=true,block-quic=true,fast-open=default,vmess-aead=default,skip-cert-verify=true,enabled=true,flexible-sni=false
一元 = 订阅地址,udp=true,block-quic=true,fast-open=default,vmess-aead=default,skip-cert-verify=true,enabled=true,flexible-sni=false



[Remote Filter]
香港节点筛选 = NameRegex,花云,一元, FilterKey = "(🇭🇰)|(香港)|(Hong)|(HK)"
新加坡节点筛选 = NameRegex,花云,一元, FilterKey = "(🇸🇬)|(新加坡)|(Singapore)|(SG)"
美国节点筛选 = NameRegex,花云,一元, FilterKey = "(🇺🇸)|(美国)|(States)|(US)"
日本节点筛选 = NameRegex,花云,一元, FilterKey = "(🇯🇵)|(日本)|(Japan)|(JP)"
台湾节点筛选 = NameRegex,花云,一元, FilterKey = "(🇨🇳)|(台湾)|(Tai)|(TW)"
韩国节点筛选 = NameRegex,花云,一元, FilterKey = "(🇰🇷)|(韩国)|(韓國)|(Korea)|(KR)"
加拿大节点筛选 = NameRegex,花云,一元, FilterKey = "(🇨🇦)|(加拿大)|(Canada)|(CA)"
荷兰节点筛选 = NameRegex,花云,一元, FilterKey = "(🇳🇱)|(荷兰)|(荷蘭)|(Netherlands)|(Holland)|(NL)"
德国节点筛选 = NameRegex,花云,一元, FilterKey = "(🇩🇪)|(德国)|(德國)|(Germany)|(DE)"
英国节点筛选 = NameRegex,花云,一元, FilterKey = "(🇬🇧)|(英国)|(英國)|(United Kingdom)|(Britain)|(UK)"
法国节点筛选 = NameRegex,花云,一元, FilterKey = "(🇫🇷)|(法国)|(法國)|(France)|(FR)"
其他节点筛选 = NameRegex,花云,一元, FilterKey = "^(?!.*((GB)|(Expire)|(🇭🇰)|(香港)|(Hong)|(HK)|(🇯🇵)|(日本)|(Japan)|(JP)|(🇸🇬)|(新加坡)|(Singapore)|(SG)|(🇺🇸)|(美国)|(States)|(US)|(🇨🇳)|(台湾)|(Tai)|(TW)|(🇰🇷)|(韩国)|(韓國)|(Korea)|(KR)|(🇩🇪)|(德国)|(德國)|(Germany)|(DE)|(🇬🇧)|(英国)|(英國)|(United Kingdom)|(Britain)|(UK)|(🇳🇱)|(荷兰)|(荷蘭)|(Netherlands)|(Holland)|(NL)|(🇫🇷)|(法国)|(法國)|(France)|(FR)|(🇨🇦)|(加拿大)|(Canada)|(CA))).*$"

